# ============================================================
# TEHAS / Arel — Ortam Degiskenleri Referans Dosyasi
# Bu dosyayi kopyalayip .env.local adini verin:
#   cp .env.example .env.local
# Gercek degerleri Vercel Dashboard > Settings > Environment Variables
# bolumunden alip buraya YAZMAYIN — bu dosya repoda gorunur.
# ============================================================

# ── Notion (Zorunlu) ────────────────────────────────────────
# Notion Integration sayfasindan alinir: https://www.notion.so/my-integrations
NOTION_TOKEN=

# Ariza bildirimi veritabani ID'si
# Notion veritabani URL'sindeki 32 karakterlik ID
NOTION_DATABASE_ID=

# Musteri degerlendirme veritabani ID'si
# Henuz kullanilmiyor; degerlendirme.js su an NOTION_DATABASE_ID'yi kullaniyor
NOTION_DEGERLENDIRME_DATABASE_ID=

# ── ImgBB (Opsiyonel) ───────────────────────────────────────
# Ariza fotografi yukleme icin: https://api.imgbb.com/
# Tanimlanmazsa fotograf adimi atlanir, form yine de calisir
IMGBB_API_KEY=

# ── Auth / JWT (FAZ-2 — Henuz Aktif Degil) ──────────────────
# OTP dogrulama ve JWT token imzalama icin gizli anahtar.
# En az 32 karakterlik, rastgele uretilmis bir deger olmali.
# Ornek uretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DIKKAT: Bos birakilirsa api/auth.js 500 hatasi doner (kasitli — fallback yok).
JWT_SECRET=

# Hangi origin'lerden istek kabul edilecegi (CORS)
# Ornek: https://arel-phi.vercel.app
# Tanimlanmazsa * (tum originler) gecerli olur
ALLOWED_ORIGIN=

# ── WhatsApp Business API (Taslak — Aktif Degil) ────────────
# api/bildirim-gonder.js icinde tanimli, henuz kullanilmiyor
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Vercel Deploy (GitHub Actions icin) ─────────────────────
# deploy.yml su an .github/workflows/ altinda degil; Vercel native
# entegrasyonu kullaniliyor. Asagidaki degerler yalnizca GitHub Actions
# uzerinden manuel deploy yapilacaksa gereklidir.
# VERCEL_TOKEN=
# ORG_ID=
# PROJECT_ID=

# ── Notlar ──────────────────────────────────────────────────
# ADMIN_PHONE (905367807059): Public is numarasi. WhatsApp linklerinde
# ve api/durum-sorgula.js (client-side) icinde hardcoded.
# Static HTML/client-side JS'de process.env kullanilamaz;
# numara degisirse asagidaki dosyalarda elle guncellenmeli:
#   - api/durum-sorgula.js satir 728
#   - fiyat.html satir 380
#   - teknisyen.html satir 516
#   - hakkimizda.html (2 yer)
#   - hizmetler.html (7 yer)
#   - iletisim.html (3 yer)
